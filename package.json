{
  "name": "doutor-do-celular",
  "version": "2.0.0",
  "description": "Doutor do Celular, Kauan Cell: loja on-line, assistência técnica e gestão (front estático + API Express/Prisma).",
  "private": true,
  "scripts": {
    "dev": "node tools/serve.mjs",
    "dev:api": "ts-node-dev --respawn --transpile-only --project backend/tsconfig.json backend/src/server.ts",
    "build": "node build.mjs",
    "vercel-build": "prisma migrate deploy && node build.mjs",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p backend/tsconfig.prisma.json && tsc --noEmit -p tsconfig.api.json",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node --project backend/tsconfig.prisma.json backend/prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "ts-node --project backend/tsconfig.prisma.json backend/prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.0",
    "puppeteer-core": "^23.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
