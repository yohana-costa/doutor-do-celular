# Copie para .env (desenvolvimento local). Na Vercel, configure em Settings > Environment Variables.

# Postgres. Na Vercel, a integracao com o Neon cria as duas automaticamente:
# DATABASE_URL = conexao com pool (usada pela API); DATABASE_URL_UNPOOLED = conexao direta (usada pelo prisma migrate).
DATABASE_URL="postgresql://usuario:senha@localhost:5436/doutor_celular?schema=public"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@localhost:5436/doutor_celular?schema=public"

# Segredo dos tokens (equipe, cliente e acesso a pedido/OS). Obrigatorio em producao, minimo 16 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo"

# Vercel Blob (fotos de produto). A integracao do Blob cria esta variavel.
# Vazio no desenvolvimento local: as fotos vao para a pasta uploads/.
BLOB_READ_WRITE_TOKEN=""

# Opcionais
# PORT=3342                      porta da API local (npm run dev:api)
# JWT_EXPIRES_IN="7d"            sessao da equipe
# CLIENTE_JWT_EXPIRES_IN="30d"   sessao do cliente
# ACESSO_JWT_EXPIRES_IN="60d"    acesso a um pedido/OS sem conta
